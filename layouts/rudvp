// Russian on Dvorak-Programmer key positions.
//
// Generated by scripts/gen-layouts.py from config/eyelash_corne.keymap.
// Do not edit by hand -- re-run the generator after changing layer 1.
//
// Pair this with the firmware pinned to its DVP layer: every Cyrillic
// letter then sits on the same physical key as stock `ru` does with the
// firmware on QWERTY, so the keyboard never has to change layers to
// change language.
//
// The file is named `rudvp` rather than `ru` on purpose. xkb resolves
// includes against the user directory first, so a user file called `ru`
// would make `include "ru(winkeys)"` below recurse into itself.

default partial alphanumeric_keys
xkb_symbols "dvp" {

    include "ru(winkeys)"
    name[Group1] = "Russian (Dvorak Programmer)";

    key <AB01> {[             period,              comma ]}; // . ,
    key <AB02> {[         Cyrillic_i,         Cyrillic_I ]}; // и И
    key <AB03> {[       Cyrillic_sha,       Cyrillic_SHA ]}; // ш Ш
    key <AB04> {[        Cyrillic_yu,        Cyrillic_YU ]}; // ю Ю
    key <AB05> {[        Cyrillic_te,        Cyrillic_TE ]}; // т Т
    key <AB06> {[        Cyrillic_de,        Cyrillic_DE ]}; // д Д
    key <AB07> {[  Cyrillic_softsign,  Cyrillic_SOFTSIGN ]}; // ь Ь
    key <AB08> {[       Cyrillic_tse,       Cyrillic_TSE ]}; // ц Ц
    key <AB09> {[         Cyrillic_u,         Cyrillic_U ]}; // у У
    key <AB10> {[         Cyrillic_e,         Cyrillic_E ]}; // э Э
    key <AC01> {[        Cyrillic_ef,        Cyrillic_EF ]}; // ф Ф
    key <AC02> {[       Cyrillic_zhe,       Cyrillic_ZHE ]}; // ж Ж
    key <AC03> {[        Cyrillic_er,        Cyrillic_ER ]}; // р Р
    key <AC04> {[        Cyrillic_en,        Cyrillic_EN ]}; // н Н
    key <AC05> {[       Cyrillic_ghe,       Cyrillic_GHE ]}; // г Г
    key <AC06> {[         Cyrillic_o,         Cyrillic_O ]}; // о О
    key <AC07> {[        Cyrillic_es,        Cyrillic_ES ]}; // с С
    key <AC08> {[        Cyrillic_em,        Cyrillic_EM ]}; // м М
    key <AC09> {[        Cyrillic_ze,        Cyrillic_ZE ]}; // з З
    key <AC10> {[    Cyrillic_shorti,    Cyrillic_SHORTI ]}; // й Й
    key <AC11> {[        Cyrillic_ya,        Cyrillic_YA ]}; // я Я
    key <AD01> {[       Cyrillic_che,       Cyrillic_CHE ]}; // ч Ч
    key <AD02> {[        Cyrillic_be,        Cyrillic_BE ]}; // б Б
    key <AD03> {[        Cyrillic_ve,        Cyrillic_VE ]}; // в В
    key <AD04> {[     Cyrillic_shcha,     Cyrillic_SHCHA ]}; // щ Щ
    key <AD05> {[        Cyrillic_el,        Cyrillic_EL ]}; // л Л
    key <AD06> {[        Cyrillic_ie,        Cyrillic_IE ]}; // е Е
    key <AD07> {[         Cyrillic_a,         Cyrillic_A ]}; // а А
    key <AD08> {[        Cyrillic_pe,        Cyrillic_PE ]}; // п П
    key <AD09> {[      Cyrillic_yeru,      Cyrillic_YERU ]}; // ы Ы
    key <AD10> {[        Cyrillic_ka,        Cyrillic_KA ]}; // к К
};
