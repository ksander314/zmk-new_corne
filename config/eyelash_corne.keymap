#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <175>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        to_dvp: to_dvp {
          compatible = "zmk,behavior-macro";
          wait-ms = <30>;
          tap-ms = <30>;
          #binding-cells = <0>;
          bindings = <
            &kp LC(LS(LA(LG(N1))))  // Hyper+1 → Hammerspoon → set ABC
            &to 1
          >;
        };

        td_bt_clr: td_bt_clr {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Double Tap BT Clear";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_CLR>;
        };

        td_boot: td_boot {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Double Tap Bootloader";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bootloader>;
        };

        to_qwerty: to_qwerty {
          compatible = "zmk,behavior-macro";
          wait-ms = <30>;
          tap-ms = <30>;
          #binding-cells = <0>;
          bindings = <
            &kp LC(LS(LA(LG(N2))))  // Hyper+2 → Hammerspoon → set Russian
            &to 0
          >;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        combo_minus {
            timeout-ms = <50>;
            key-positions = <25 26>;  // N + S on DVP home row (right ring + pinky) → minus/э
            bindings = <&kp MINUS>;
            layers = <0 1 2>;
        };

        combo_lshift {
            timeout-ms = <30>;
            key-positions = <15 16>;  // S + D home (left ring + middle) → sticky LSHIFT, mirrors combo_rshift
            bindings = <&sk LEFT_SHIFT>;
            layers = <0 1>;
        };

        combo_rshift {
            timeout-ms = <30>;
            key-positions = <24 25>;  // K + L home (right middle + ring) → sticky RSHIFT
            bindings = <&sk RIGHT_SHIFT>;
            layers = <0 1>;
        };

        combo_tab {
            timeout-ms = <40>;
            key-positions = <1 2>;    // Q + W top (left pinky + ring) → TAB
            bindings = <&kp TAB>;
            layers = <0 1>;
        };

        combo_lgui {
            timeout-ms = <40>;
            key-positions = <29 30>;  // Z + X bottom-left (QWERTY) / APOS + Q (DVP) → sticky LGUI
            bindings = <&sk LEFT_GUI>;
            layers = <0 1>;
        };

        combo_comma_en {
            timeout-ms = <40>;
            key-positions = <17 23>;  // F + J home (index mirror) → COMMA → , on EN layout
            bindings = <&kp COMMA>;
            layers = <1>;
        };

        combo_comma_ru {
            timeout-ms = <40>;
            key-positions = <17 23>;  // F + J home (index mirror) → LS(FSLH) → , on Russian Mac
            bindings = <&kp LS(FSLH)>;
            layers = <0>;
        };

        combo_question_en {
            timeout-ms = <40>;
            key-positions = <14 26>;  // A + ; home (pinky mirror) → LS(FSLH) → ? on EN
            bindings = <&kp LS(FSLH)>;
            layers = <1>;
        };

        combo_question_ru {
            timeout-ms = <40>;
            key-positions = <14 26>;  // A + ; home (pinky mirror) → LS(NUMBER_7) → ? on Russian Mac
            bindings = <&kp LS(NUMBER_7)>;
            layers = <0>;
        };

        combo_colon_en {
            timeout-ms = <40>;
            key-positions = <18 22>;  // G + H home (inner index mirror) → LS(SEMI) → : on EN
            bindings = <&kp LS(SEMI)>;
            layers = <1>;
        };

        combo_colon_ru {
            timeout-ms = <40>;
            key-positions = <18 22>;  // G + H home (inner index mirror) → LS(NUMBER_6) → : on Russian Mac
            bindings = <&kp LS(NUMBER_6)>;
            layers = <0>;
        };

        combo_caps_word {
            timeout-ms = <40>;
            key-positions = <33 36>;  // B + N bottom-inner-index → caps_word (auto-off on space)
            bindings = <&caps_word>;
            layers = <0 1>;
        };

        combo_tilde {
            timeout-ms = <40>;
            key-positions = <3 9>;    // E + I top row (left middle + right ring) → ~ in EN, Ё in RU
            bindings = <&kp LS(GRAVE)>;
            layers = <0 1>;
        };

        combo_lbkt {
            timeout-ms = <40>;
            key-positions = <2 15>;   // , + O (left ring vertical) → [
            bindings = <&kp LEFT_BRACKET>;
            layers = <1>;
        };

        combo_lbrace {
            timeout-ms = <40>;
            key-positions = <3 16>;   // . + E (left middle vertical) → {
            bindings = <&kp LEFT_BRACE>;
            layers = <1>;
        };

        combo_rbrace {
            timeout-ms = <40>;
            key-positions = <4 17>;   // P + U (left index vertical) → }
            bindings = <&kp RIGHT_BRACE>;
            layers = <1>;
        };

        combo_lparen {
            timeout-ms = <40>;
            key-positions = <5 18>;   // Y + I (left index-stretch vertical) → (
            bindings = <&kp LS(NUMBER_9)>;
            layers = <1>;
        };

        combo_rparen {
            timeout-ms = <40>;
            key-positions = <9 24>;   // C + T (right middle vertical) → )
            bindings = <&kp LS(NUMBER_0)>;
            layers = <1>;
        };

        combo_rbkt {
            timeout-ms = <40>;
            key-positions = <11 26>;  // L + S (right pinky vertical) → ]
            bindings = <&kp RIGHT_BRACKET>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "QWERTY";
            bindings = <
&none                &kp Q  &kp W  &kp E     &kp R  &kp T                               &kp UP                &kp Y              &kp U     &kp I      &kp O    &kp P     &none
&none                &kp A  &kp S  &kp D     &kp F  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp H              &kp J     &kp K      &kp L    &kp SEMI  &none
&none                &kp Z  &kp X  &kp C     &kp V  &kp B        &trans                 &kp DOWN              &kp N              &kp M     &kp COMMA  &kp DOT  &kp FSLH  &none
                         &kp LALT  &mt LCTRL SPACE  &lt 2 ESCAPE                                           &kp BSPC  &mt RCTRL ENTER  &kp LEFT_GUI
            >;

             sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;

           
        };

        layer_1 {
            display-name = "DVP";
            bindings = <
&none           &kp SEMI         &kp COMMA       &kp DOT       &kp P         &kp Y                                   &kp UP                     &kp F            &kp G            &kp C            &kp R            &kp L     &none
&none           &kp A            &kp O           &kp E         &kp U         &kp I                   &kp LEFT  &kp ENTER       &kp RIGHT  &kp D            &kp H            &kp T            &kp N            &kp S     &none
&none           &kp APOS         &kp Q           &kp J         &kp K         &kp X                   &kp C_MUTE      &kp DOWN                   &kp B            &kp M            &kp W            &kp V            &kp Z     &none
                                                 &kp LALT        &mt LCTRL SPACE  &lt 2 ESCAPE                                                         &kp BSPC         &mt RCTRL ENTER  &kp LEFT_GUI
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            display-name = "SPEC";
            bindings = <
&none                       &mt GRAVE LS(NUMBER_7)  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LS(NUMBER_9)          &trans          &kp EQUAL         &kp LS(NUMBER_8)  &kp LS(NUMBER_0)  &kp LS(EQUAL)    &kp RIGHT_BRACKET    &none
&none                       &kp NUMBER_7            &kp NUMBER_5    &kp NUMBER_3        &kp NUMBER_1         &kp NUMBER_9      &trans  &trans  &trans  &kp NUMBER_0      &kp NUMBER_2      &kp NUMBER_4      &kp NUMBER_6     &kp APOS           &none
&none                       &kp NUMBER_8            &kp TAB         &to 3               &kp PAGE_DOWN        &sk LEFT_SHIFT  &trans  &trans          &sk RIGHT_SHIFT   &kp LS(NUMBER_3)  &kp SLASH         &kp LS(NUMBER_2) &kp BACKSLASH      &none
                                                                    &kp PRINTSCREEN     &none               &kp ESCAPE                                 &kp INSERT       &kp DELETE        &kp RALT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "BTWN";
            bindings = <
&none        &kp F1      &kp F2     &kp F3       &kp F4     &bt BT_NXT                                  &mmv MOVE_UP                     &td_bt_clr       &kp F7     &kp F8       &kp F9      &kp F10          &none
&none        &trans      &mkp LCLK  &mkp MCLK    &td_boot   &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mkp LCLK    &td_boot   &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &none
&none        &sys_reset  &trans     &to_qwerty        &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &trans       &sys_reset  &kp SCROLLLOCK   &none
                                    &trans       &trans      &to_dvp                                                                  &trans       &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
