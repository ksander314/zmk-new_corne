_US = {
    "GRAVE": "`~", "N1": "1!", "N2": "2@", "N3": "3#", "N4": "4$", "N5": "5%",
    "N6": "6^", "N7": "7&", "N8": "8*", "N9": "9(", "N0": "0)", "MINUS": "-_",
    "EQUAL": "=+", "LBKT": "[{", "RBKT": "]}", "BSLH": "\\|", "SEMI": ";:",
    "SQT": "'\"", "COMMA": ",<", "DOT": ".>", "FSLH": "/?",
}
# macOS "Russian – PC" (input source id RussianWin), by US key position.
_RU = {
    "GRAVE": "ёЁ", "N1": "1!", "N2": "2\"", "N3": "3№", "N4": "4;", "N5": "5%",
    "N6": "6:", "N7": "7?", "N8": "8*", "N9": "9(", "N0": "0)", "MINUS": "-_",
    "EQUAL": "=+", "LBKT": "хХ", "RBKT": "ъЪ", "BSLH": "\\/", "SEMI": "жЖ",
    "SQT": "эЭ", "COMMA": "бБ", "DOT": "юЮ", "FSLH": ".,",
}
_RU_LETTERS = dict(zip("QWERTYUIOPASDFGHJKLZXCVBNM", "йцукенгшщзфывапролдячсмить"))
_COMMON = {"SPACE": "  ", "TAB": "\t\t", "BSPC": "\b\b", "ENTER": "\n\n"}


def _table(punct, letters):
    t = dict(_COMMON)
    t.update(punct)
    for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        low = letters.get(c, c.lower())
        t[c] = low + low.upper()
    return t


CHARS = {"ABC": _table(_US, {}), "RussianWin": _table(_RU, _RU_LETTERS)}

CHAR_NAMES = {" ": "SPC", "\t": "TAB", "\b": "BSPC", "\n": "RET"}


@dataclass(frozen=True)
class Keycode:
    key: str            # canonical US key, or the raw ZMK name if unknown
    shift: bool
    other_mods: bool    # Ctrl/Alt/GUI present -> not a printable char

    def char(self, layout, extra_shift=False):
        if self.other_mods or self.key not in CHARS[layout]:
            return None
        return CHARS[layout][self.key][1 if (self.shift or extra_shift) else 0]

    @property
    def is_shift_mod(self):
        return self.key in ("LEFT_SHIFT", "RIGHT_SHIFT", "LSHIFT", "RSHIFT", "LSHFT", "RSHFT")


def parse_keycode(s):
    mods = []
    while m := re.fullmatch(r"([LR][SCAG])\((.*)\)", s):
        mods.append(m.group(1))
        s = m.group(2)
    key, implicit = ALIASES.get(s, (s, False))
    shift = implicit or any(m[1] == "S" for m in mods)
    return Keycode(key, shift, any(m[1] != "S" for m in mods))


# ---------------------------------------------------------------- keymap

@dataclass
class Binding:
    behavior: str
    args: list

    def __str__(self):
        return " ".join(["&" + self.behavior, *self.args])


@dataclass
class Combo:
    name: str
    positions: list
    binding: Binding
    layers: list = field(default_factory=list)  # empty = all layers

    def active_on(self, layer):
        return not self.layers or layer in self.layers


@dataclass
class Keymap:
    layer_names: list
    layers: list        # list[list[Binding]]
    combos: list


def _strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"//[^\n]*", "", text)


def _bindings(body):
    out = []
    for tok in body.split():
        if tok.startswith("&"):
            out.append(Binding(tok[1:], []))
        elif out:
            out[-1].args.append(tok)
    return out


def load_keymap(path=KEYMAP):
    text = _strip_comments(path.read_text())
    combos = []
    for m in re.finditer(r"(\w+)\s*\{([^{}]*key-positions[^{}]*)\}", text):
        body = m.group(2)
        field_ = lambda k: re.search(rf"\b{k}\s*=\s*<([^>]*)>", body)
        layers = field_("layers")
        combos.append(Combo(
            name=m.group(1),
            positions=[int(x) for x in field_("key-positions").group(1).split()],
            binding=_bindings(field_("bindings").group(1))[0],
            layers=[int(x) for x in layers.group(1).split()] if layers else [],
        ))
    km = text[text.index('"zmk,keymap"'):]
    names, layers = [], []
    for m in re.finditer(r"(\w+)\s*\{\s*(?:display-name\s*=\s*\"([^\"]*)\";)?\s*bindings\s*=\s*<(.*?)>;",
                         km, flags=re.S):
        names.append(m.group(2) or m.group(1))
        layers.append(_bindings(m.group(3)))
    return Keymap(names, layers, combos)


# ---------------------------------------------------------------- positions

LEFT_FINGERS = ["мизинец", "безымянный", "средний", "указательный", "указательный (внутр.)"]
RIGHT_FINGERS = list(reversed(LEFT_FINGERS))


def describe_pos(p):
    """Human description of a physical position (config/eyelash_corne.json)."""
    rows = [(0, 12, "верхний ряд"), (13, 27, "домашний ряд"), (28, 41, "нижний ряд")]
    if p >= 42:
        side = "левый" if p <= 44 else "правый"
        which = ["внешняя", "средняя", "внутренняя"][p - 42 if p <= 44 else 47 - p]
        return f"{side} большой, {which}"
    for lo, hi, row in rows:
        if lo <= p <= hi:
            col = p - lo
            if col in (0, hi - lo):
                return f"крайняя колонка, {row}"
            if 1 <= col <= 5:
                return f"левый {LEFT_FINGERS[col - 1]}, {row}"
            right = hi - lo - col          # 1..5 counted from the outer edge
            if 1 <= right <= 5:
                return f"правый {RIGHT_FINGERS[5 - right]}, {row}"
            return {6: "5-way вверх", 19: "5-way влево", 20: "5-way нажатие", 21: "5-way вправо",
                    34: "энкодер", 35: "5-way вниз"}.get(p, f"позиция {p}")
    return f"позиция {p}"


def cap_label(binding):
    """What is printed on the key in a base layer: 'S', ';', 'Esc'."""
    if binding is None or binding.behavior in ("none", "trans"):
        return "·"
    if binding.behavior in ("kp", "mt", "lt") and binding.args:
        kc = parse_keycode(binding.args[-1])
        ch = kc.char("ABC")
        if ch and ch.isprintable() and ch.strip():
            return ch.upper()
        return kc.key.title()
    return str(binding)


def pos_label(km, p):
    return f"QWERTY {cap_label(km.layers[0][p])} · DVP {cap_label(km.layers[1][p])}"


# ---------------------------------------------------------------- ways

@dataclass
class Way:
    steps: list          # human-readable steps
    presses: list        # ("key", layer, pos) | ("combo", layer, combo_index)

    @property
    def cost(self):
        return len(self.steps)


def resolve(km, layer, pos):
    b = km.layers[layer][pos]
    while b.behavior == "trans" and layer > 0:
        layer -= 1
        b = km.layers[layer][pos]
    return b


def outputs(binding):
    """(kind, Keycode) pairs a binding can send: kind is 'тап' or 'удержание'."""
    a = binding.args
    if binding.behavior == "kp" and a:
        return [("тап", parse_keycode(a[0]))]
    if binding.behavior == "mt" and len(a) == 2:
        return [("тап", parse_keycode(a[1])), ("удержание", parse_keycode(a[0]))]
    if binding.behavior == "lt" and len(a) == 2:
        return [("тап", parse_keycode(a[1]))]
    return []


def is_shift(binding):
    return binding.behavior in ("sk", "kp") and binding.args and parse_keycode(binding.args[0]).is_shift_mod


def combo_text(km, c, base):
    caps = " + ".join(cap_label(km.layers[base][p]) for p in c.positions)
    return f"combo {c.name} ({caps})"


def ways_for(km, layout, char):
    base = OS_LAYOUTS[layout]
    base_name = km.layer_names[base]
    spec_pos = next((p for p, b in enumerate(km.layers[base])
                     if b.behavior == "lt" and b.args[:1] == [str(SPEC)]), None)
    contexts = [(base, [], [])]
    if spec_pos is not None:
        contexts.append((SPEC, [f"держать {km.layer_names[SPEC]}: {describe_pos(spec_pos)} "
                                f"[{cap_label(km.layers[base][spec_pos])}]"],
                         [("key", base, spec_pos)]))
    found = []
    for layer, pre_steps, pre_presses in contexts:
        sources = []   # (step text, presses, binding)
        for p in range(len(km.layers[layer])):
            b = resolve(km, layer, p)
            sources.append((f"{describe_pos(p)} [{pos_label(km, p)}]", [("key", layer, p)], b))
        for i, c in enumerate(km.combos):
            if c.active_on(layer):
                sources.append((combo_text(km, c, base), [("combo", layer, i)], c.binding))
        shifts = [(f"Shift: {text}", presses) for text, presses, b in sources if is_shift(b)]
        for text, presses, b in sources:
            for kind, kc in outputs(b):
                if kc.char(layout) == char:
                    found.append(Way(pre_steps + [f"{kind}: {text}"], pre_presses + presses))
                elif not kc.shift and kc.char(layout, extra_shift=True) == char:
                    for s_text, s_presses in shifts:
                        found.append(Way(pre_steps + [s_text, f"{kind}: {text}"],
                                         pre_presses + s_presses + presses))
    found.sort(key=lambda w: w.cost)
    return found


def shortest(ways):
    return [w for w in ways if w.cost == ways[0].cost] if ways else []


# ---------------------------------------------------------------- find

def cmd_find(args):
    km = load_keymap()
    layouts = [OS_LAYOUT_ALIASES[args.layout]] if args.layout else list(OS_LAYOUTS)
    chars = [ch for arg in args.chars for ch in ([" "] if arg == "SPC" else arg)]
    for char in chars:
        for layout in layouts:
            base = km.layer_names[OS_LAYOUTS[layout]]
            ways = ways_for(km, layout, char)
            head = f"{CHAR_NAMES.get(char, char)}  в {layout} (слой {base})"
            if not ways:
                print(f"{head}: не набирается\n")
                continue
            print(f"{head}:")
            for w in ways[: args.max]:
                print("  " + "  →  ".join(w.steps))
            if len(ways) > args.max:
                print(f"  … ещё {len(ways) - args.max}, --max N чтобы увидеть")
            print()


# ---------------------------------------------------------------- heatmap

def read_log(days):
    since = (time.time() - days * 86400) * 1000 if days else 0
    counts = collections.Counter()
    skipped = collections.Counter()
    relabeled = 0
    unsanitize = {"COMMA": ",", "SPC": " ", "TAB": "\t", "RET": "\n"}
    # The `layout` column lags behind real switches (it is polled every few
    # seconds), so letters decide the layout and other chars inherit it.
    current = None
    with KLOG.open(newline="") as f:
        for row in csv.DictReader(f):
            try:
                if int(row["timestamp_ms"]) < since:
                    continue
            except ValueError:
                continue
            if row["event"] == "backspace":
                char = "\b"
            elif row["event"] == "char":
                char = unsanitize.get(row["key"], row["key"])
            else:
                skipped["chord"] += 1
                continue
            if char.isalpha() and len(char) == 1:
                current = "RussianWin" if "Ѐ" <= char <= "ӿ" else "ABC"
            layout = current or row["layout"]
            if layout not in OS_LAYOUTS:
                skipped[f"layout {layout or '?'}"] += 1
                continue
            relabeled += layout != row["layout"]
            counts[(layout, char)] += 1
    return counts, skipped, relabeled


def heat(counts, km):
    keys = collections.Counter()      # (layer, pos) -> weight
    combos = collections.Counter()    # (layer, combo index) -> weight
    unreachable = collections.Counter()
    cache = {}
    for (layout, char), n in counts.items():
        if (layout, char) not in cache:
            cache[(layout, char)] = shortest(ways_for(km, layout, char))
        ways = cache[(layout, char)]
        if not ways:
            unreachable[(layout, char)] += n
            continue
        for w in ways:
            for kind, layer, idx in w.presses:
                (keys if kind == "key" else combos)[(layer, idx)] += n / len(ways)
    return keys, combos, unreachable


HEAT_COLORS = ["#fff7d6", "#ffeaa8", "#ffd47a", "#ffb35a", "#ff8c42", "#f2622e", "#d43a2a", "#a8201a"]


def bucket(v, vmax):
    """Colour index; sqrt scale relative to the busiest key of the same layer."""
    if v <= 0 or vmax <= 0:
        return None
    return min(len(HEAT_COLORS) - 1, int(len(HEAT_COLORS) * math.sqrt(v / vmax)))


def drawer(*args, stdin=None):
    r = subprocess.run(["uvx", "--quiet", "--from", "keymap-drawer", "keymap", *args],
                       input=stdin, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"keymap-drawer {args[2]} упал:\n{r.stderr}")
    return r.stdout


def drawer_config(extra_css=""):
    import yaml
    cfg = yaml.safe_load(DRAWER_CONFIG.read_text())
    cfg["draw_config"]["svg_extra_style"] = cfg["draw_config"].get("svg_extra_style", "") + extra_css
    f = tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False)
    yaml.safe_dump(cfg, f, allow_unicode=True)
    f.close()
    return f.name


def parsed_keymap(cfg):
    import yaml
    return yaml.safe_load(drawer("-c", cfg, "parse", "-z", str(KEYMAP)))


def render(cfg, data, name):
    import yaml
    OUT.mkdir(exist_ok=True)
    svg = drawer("-c", cfg, "draw", "-j", str(LAYOUT_JSON), "-",
                 stdin=yaml.safe_dump(data, allow_unicode=True, sort_keys=False))
    path = OUT / name
    path.write_text(svg)
    return path


def open_in_emacs(path):
    subprocess.run(["emacsclient", "-n", str(path)], check=False)


def cmd_heatmap(args):
    km = load_keymap()
    counts, skipped, relabeled = read_log(args.days)
    keys, combos, unreachable = heat(counts, km)
    vmax = collections.defaultdict(lambda: 1.0)
    for (layer, _), v in [*keys.items(), *combos.items()]:
        vmax[layer] = max(vmax[layer], v)

    css = "".join(f"\nrect.heat{i}, rect.combo.heat{i} {{ fill: {c}; }}" for i, c in enumerate(HEAT_COLORS))
    cfg = drawer_config(css)
    data = parsed_keymap(cfg)
    old_names = list(data["layers"])
    totals = collections.Counter()
    for (layer, _), v in keys.items():
        totals[layer] += v
    usage = {v: k for k, v in OS_LAYOUTS.items()}

    def tag(spec, b):
        spec = {"t": spec} if not isinstance(spec, dict) else dict(spec)
        if b is not None and spec.get("type") not in ("none", "trans"):
            spec["type"] = f"heat{b}"
        return spec

    new_layers, rename = {}, {}
    for li, name in enumerate(old_names):
        title = f"{name} · {usage.get(li, 'из базового')} · {round(totals[li])} нажатий"
        rename[name] = title
        new_layers[title] = [tag(k, bucket(keys[(li, p)], vmax[li])) for p, k in enumerate(data["layers"][name])]
    data["layers"] = new_layers

    # Split each drawn combo per layer so every layer shows its own heat.
    new_combos = []
    for c in data.get("combos", []):
        layer_names = c.get("l") or old_names
        for ln in layer_names:
            li = old_names.index(ln)
            idx = next((i for i, kc in enumerate(km.combos)
                        if sorted(kc.positions) == sorted(c["p"]) and kc.active_on(li)), None)
            b = bucket(combos[(li, idx)], vmax[li]) if idx is not None else None
            new_combos.append({**c, "k": tag(c.get("k", ""), b), "l": [rename[ln]]})
    data["combos"] = new_combos

    path = render(cfg, data, "heatmap.svg")
    total = sum(counts.values())
    print(f"{path}\n")
    print(f"Учтено {total} нажатий из {KLOG} (только Emacs, без eshell/term).")
    if skipped:
        print("Не учтено: " + ", ".join(f"{k} {v}" for k, v in skipped.most_common()))
    if relabeled:
        print(f"У {relabeled} нажатий колонка layout в логе расходится с набранными буквами — взята раскладка по буквам.")

    top = sorted(((v, ("key", l, p)) for (l, p), v in keys.items()), reverse=True)[:12]
    print("\nСамые нагруженные клавиши")
    print(f"{'Клавиша':<64} {'Слой':<7} {'Нажатий':>8}")
    print("─" * 81)
    for v, (_, l, p) in top:
        print(f"{describe_pos(p) + ' [' + pos_label(km, p) + ']':<64} {km.layer_names[l]:<7} {round(v):>8}")
    ctop = sorted(((v, k) for k, v in combos.items()), reverse=True)[:10]
    if ctop:
        print("\nCombos")
        print(f"{'Combo':<22} {'Слой':<7} {'Нажатий':>8}")
        print("─" * 39)
        for v, (l, i) in ctop:
            print(f"{km.combos[i].name:<22} {km.layer_names[l]:<7} {round(v):>8}")
    if unreachable:
        print("\nНабрано, но раскладка такой символ не даёт (другая клавиатура или ввод не с клавиш):")
        print("  " + ", ".join(f"{CHAR_NAMES.get(c, c)} ({l}) {n}" for (l, c), n in unreachable.most_common(15)))
    if args.open:
        open_in_emacs(path)


def cmd_draw(args):
    cfg = drawer_config()
    path = render(cfg, parsed_keymap(cfg), "keymap.svg")
    print(path)
    if args.open:
        open_in_emacs(path)


# ---------------------------------------------------------------- fetch / flash

def git(*a):
    return subprocess.run(["git", "-C", str(REPO), *a], capture_output=True, text=True, check=True).stdout.strip()


def gh(*a, check=True):
    return subprocess.run(["gh", *a], cwd=REPO, capture_output=True, text=True, check=check).stdout.strip()


def cmd_fetch(args):
    sha = git("rev-parse", "HEAD")
    short = sha[:7]
    dest = FIRMWARE / short
    if list(dest.glob("*.uf2")):
        print(f"Уже скачано: {dest}")
        return dest
    if git("status", "--porcelain", "--untracked-files=no", "--", "config", "boards", "build.yaml"):
        print("Внимание: в config/ boards/ build.yaml есть незакоммиченные правки — их в сборке нет.")
    if not git("branch", "-r", "--contains", sha):
        sys.exit(f"{short} не запушен — CI его не собирал. Сначала git push.")

    def run_id():
        out = gh("run", "list", "-w", "build.yml", "--commit", sha, "-L", "1",
                 "--json", "databaseId", "-q", ".[0].databaseId")
        return out or None

    rid = run_id()
    if not rid:
        branch = git("rev-parse", "--abbrev-ref", "HEAD")
        print(f"Сборки для {short} нет, запускаю build.yml на {branch}")
        gh("workflow", "run", "build.yml", "--ref", branch)
        for _ in range(30):
            time.sleep(3)
            if rid := run_id():
                break
        else:
            sys.exit("Сборка не появилась за 90 с, проверь `gh run list`.")
    print(f"Жду сборку {rid} для {short}…", flush=True)
    if subprocess.run(["gh", "run", "watch", rid, "--exit-status", "--interval", "10"], cwd=REPO).returncode:
        sys.exit(f"Сборка упала: gh run view {rid} --log-failed")
    dest.mkdir(parents=True, exist_ok=True)
    gh("run", "download", rid, "-n", "firmware", "-D", str(dest))
    for f in sorted(dest.glob("*.uf2")):
        print(f"  {f}")
    return dest


def uf2_volume():
    vols = [v for v in glob.glob("/Volumes/*") if os.path.exists(os.path.join(v, "INFO_UF2.TXT"))]
    return vols[0] if vols else None


def cmd_flash(args):
    dest = cmd_fetch(args)
    files = [f for f in dest.glob("*.uf2") if f"_{args.side}" in f.name]
    if len(files) != 1:
        sys.exit(f"Не нашёл ровно одну прошивку для {args.side} в {dest}: {[f.name for f in files]}")
    fw = files[0]
    if not (vol := uf2_volume()):
        key = "левый указательный" if args.side == "left" else "правый указательный"
        print(f"Подключи {args.side} половину по USB и войди в bootloader: SPEC → BTWN (&to 3), "
              f"двойной тап &td_boot ({key}, домашний ряд).")
        print("Жду диск с INFO_UF2.TXT…")
        for _ in range(240):
            time.sleep(0.5)
            if vol := uf2_volume():
                break
        else:
            sys.exit("Диск bootloader не появился за 2 минуты.")
    print(f"{fw.name} → {vol}")
    # The board reboots as soon as the copy finishes; cp may report an error then.
    subprocess.run(["cp", "-X", str(fw), vol], check=False)
    for _ in range(20):
        if not os.path.exists(vol):
            print(f"Готово: половина перезагрузилась. На экране должно быть {dest.name}.")
            return
        time.sleep(0.5)
    print(f"Диск {vol} не исчез — проверь, прошилось ли.")


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="kb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(required=True)

    p = sub.add_parser("find", help="как набрать символ")
    p.add_argument("chars", nargs="+", help="символы; 'SPC' для пробела")
    p.add_argument("--layout", choices=sorted(OS_LAYOUT_ALIASES), help="только одна раскладка ОС")
    p.add_argument("--max", type=int, default=4, help="сколько способов показывать")
    p.set_defaults(func=cmd_find)

    p = sub.add_parser("heatmap", help="heatmap по ~/.emacs.d/keystroke-log.csv")
    p.add_argument("--days", type=float, help="только последние N дней")
    p.add_argument("--open", action="store_true", help="открыть SVG в Emacs")
    p.set_defaults(func=cmd_heatmap)

    p = sub.add_parser("draw", help="нарисовать текущий keymap")
    p.add_argument("--open", action="store_true")
    p.set_defaults(func=cmd_draw)

    p = sub.add_parser("fetch", help="скачать прошивку CI для HEAD")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("flash", help="прошить половину")
    p.add_argument("side", choices=["left", "right"])
    p.set_defaults(func=cmd_flash)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
