def _table(punct, letters):
    t = dict(_COMMON)
    t.update(punct)
    for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        low = letters.get(c, c.lower())
        t[c] = low + low.upper()
    return t


CHARS = {"ABC": _table(_US, {}), "RussianWin": _table(_RU, _RU_LETTERS)}

CHAR_NAMES = {" ": "SPC", "\t": "TAB", "\b": "BSPC", "\n": "RET"}

# ZMK modifier key -> modifier
MODIFIERS = {
    **dict.fromkeys(("LEFT_SHIFT", "RIGHT_SHIFT", "LSHIFT", "RSHIFT", "LSHFT", "RSHFT"), "shift"),
    **dict.fromkeys(("LEFT_CONTROL", "RIGHT_CONTROL", "LCTRL", "RCTRL"), "ctrl"),
    **dict.fromkeys(("LEFT_ALT", "RIGHT_ALT", "LALT", "RALT"), "alt"),
    **dict.fromkeys(("LEFT_GUI", "RIGHT_GUI", "LGUI", "RGUI", "LEFT_COMMAND", "RIGHT_COMMAND",
                     "LCMD", "RCMD", "LEFT_WIN", "RIGHT_WIN", "LWIN", "RWIN",
                     "LEFT_META", "RIGHT_META", "LMETA", "RMETA"), "gui"),
}


@dataclass(frozen=True)
class Keycode:
    key: str            # canonical US key, or the raw ZMK name if unknown
    shift: bool
    other_mods: bool    # Ctrl/Alt/GUI present -> not a printable char

    def char(self, layout, extra_shift=False):
        if self.other_mods or self.key not in CHARS[layout]:
            return None
        return CHARS[layout][self.key][1 if (self.shift or extra_shift) else 0]

    @property
    def modifier(self):
        """'shift' / 'ctrl' / 'alt' / 'gui' for a bare modifier key, else None."""
        return None if self.other_mods else MODIFIERS.get(self.key)


def parse_keycode(s):
    mods = []
    while m := re.fullmatch(r"([LR][SCAG])\((.*)\)", s):
        mods.append(m.group(1))
        s = m.group(2)
    key, implicit = ALIASES.get(s, (s, False))
    shift = implicit or any(m[1] == "S" for m in mods)
    return Keycode(key, shift, any(m[1] != "S" for m in mods))


# ---------------------------------------------------------------- keymap

@dataclass
class Binding:
    behavior: str
    args: list

    def __str__(self):
        return " ".join(["&" + self.behavior, *self.args])


@dataclass
class Combo:
    name: str
    positions: list
    binding: Binding
    layers: list = field(default_factory=list)  # empty = all layers

    def active_on(self, layer):
        return not self.layers or layer in self.layers


@dataclass
class Keymap:
    layer_names: list
    layers: list        # list[list[Binding]]
    combos: list


def _strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"//[^\n]*", "", text)


def _bindings(body):
    out = []
    for tok in body.split():
        if tok.startswith("&"):
            out.append(Binding(tok[1:], []))
        elif out:
            out[-1].args.append(tok)
    return out


def load_keymap(path=KEYMAP):
    text = _strip_comments(path.read_text())
    combos = []
    for m in re.finditer(r"(\w+)\s*\{([^{}]*key-positions[^{}]*)\}", text):
        body = m.group(2)
        field_ = lambda k: re.search(rf"\b{k}\s*=\s*<([^>]*)>", body)
        layers = field_("layers")
        combos.append(Combo(
            name=m.group(1),
            positions=[int(x) for x in field_("key-positions").group(1).split()],
            binding=_bindings(field_("bindings").group(1))[0],
            layers=[int(x) for x in layers.group(1).split()] if layers else [],
        ))
    km = text[text.index('"zmk,keymap"'):]
    names, layers = [], []
    for m in re.finditer(r"(\w+)\s*\{\s*(?:display-name\s*=\s*\"([^\"]*)\";)?\s*bindings\s*=\s*<(.*?)>;",
                         km, flags=re.S):
        names.append(m.group(2) or m.group(1))
        layers.append(_bindings(m.group(3)))
    return Keymap(names, layers, combos)


# ---------------------------------------------------------------- positions

FINGERS = ["мизинец", "безымянный", "средний", "указательный", "указательный (внутр.)"]
ROWS = [(0, 12, "верхний ряд"), (13, 27, "домашний ряд"), (28, 41, "нижний ряд")]
CENTER = {6: "5-way вверх", 19: "5-way влево", 20: "5-way нажатие", 21: "5-way вправо",
          34: "энкодер", 35: "5-way вниз"}


def pos_info(p):
    """(hand, finger, where) of a physical position (config/eyelash_corne.json).

    hand is 'левый' / 'правый', or None for the 5-way and the encoder."""
    if p in CENTER:
        return None, None, CENTER[p]
    if p >= 42:
        left = p <= 44
        which = ["внешняя", "средняя", "внутренняя"][p - 42 if left else 47 - p]
        return ("левый" if left else "правый"), "большой", which
    lo, hi, row = next(r for r in ROWS if r[0] <= p <= r[1])
    col, right = p - lo, hi - p      # counted from the left / right outer edge
    if col == 0 or right == 0:
        return ("левый" if col == 0 else "правый"), "мизинец", f"крайняя колонка, {row}"
    if col <= 5:
        return "левый", FINGERS[col - 1], row
    return "правый", FINGERS[right - 1], row


def describe_pos(p):
    """Human description of a physical position: 'левый безымянный, домашний ряд'."""
    hand, finger, where = pos_info(p)
    if hand is None or where.startswith("крайняя"):
        return where
    return f"{hand} {finger}, {where}"


def cap_label(binding):
    """What is printed on the key in a base layer: 'S', ';', 'Esc'."""
    if binding is None or binding.behavior in ("none", "trans"):
        return "·"
    if binding.behavior in ("kp", "mt", "lt") and binding.args:
        kc = parse_keycode(binding.args[-1])
        ch = kc.char("ABC")
        if ch and ch.isprintable() and ch.strip():
            return ch.upper()
        return kc.key.title()
    return str(binding)


def pos_label(km, p):
    return f"QWERTY {cap_label(km.layers[0][p])} · DVP {cap_label(km.layers[1][p])}"


# ---------------------------------------------------------------- ways

@dataclass
class Way:
    steps: list          # human-readable steps
    presses: list        # ("key", layer, pos) | ("combo", layer, combo_index)

    @property
    def cost(self):
        return len(self.steps)


def resolve(km, layer, pos):
    b = km.layers[layer][pos]
    while b.behavior == "trans" and layer > 0:
        layer -= 1
        b = km.layers[layer][pos]
    return b


def outputs(binding):
    """(kind, Keycode) pairs a binding can send: kind is 'тап' or 'удержание'."""
    a = binding.args
    if binding.behavior == "kp" and a:
        return [("тап", parse_keycode(a[0]))]
    if binding.behavior == "mt" and len(a) == 2:
        return [("тап", parse_keycode(a[1])), ("удержание", parse_keycode(a[0]))]
    if binding.behavior == "lt" and len(a) == 2:
        return [("тап", parse_keycode(a[1]))]
    return []


def held_modifier(binding):
    """Modifier a binding holds: &kp LALT, &sk LEFT_GUI, the hold of &mt LCTRL SPACE."""
    if binding.behavior in ("kp", "sk", "mt") and binding.args:
        return parse_keycode(binding.args[0]).modifier
    return None


def is_shift(binding):
    return binding.behavior in ("sk", "kp") and held_modifier(binding) == "shift"


def combo_text(km, c, base):
    caps = " + ".join(cap_label(km.layers[base][p]) for p in c.positions)
    return f"combo {c.name} ({caps})"


def ways_for(km, layout, char):
    """Ways to type `char` with the macOS input source `layout`, cheapest first."""
    return _ways(km, layout, lambda kc, shift: kc.char(layout, extra_shift=shift) == char)


def ways_for_key(km, layout, key):
    """Ways to press a key that is not a character: 'ENTER', 'LEFT', 'F5'…"""
    return _ways(km, layout,
                 lambda kc, shift: not shift and not kc.shift and not kc.other_mods and kc.key == key)


def _ways(km, layout, match):
    """Ways to send what `match(keycode, extra_shift)` accepts, cheapest first."""
    base = OS_LAYOUTS[layout]
    spec_pos = next((p for p, b in enumerate(km.layers[base])
                     if b.behavior == "lt" and b.args[:1] == [str(SPEC)]), None)
    contexts = [(base, [], [])]
    if spec_pos is not None:
        contexts.append((SPEC, [f"держать {km.layer_names[SPEC]}: {describe_pos(spec_pos)} "
                                f"[{cap_label(km.layers[base][spec_pos])}]"],
                         [("key", base, spec_pos)]))
    found = []
    for layer, pre_steps, pre_presses in contexts:
        sources = []   # (step text, presses, binding)
        for p in range(len(km.layers[layer])):
            b = resolve(km, layer, p)
            sources.append((f"{describe_pos(p)} [{pos_label(km, p)}]", [("key", layer, p)], b))
        for i, c in enumerate(km.combos):
            if c.active_on(layer):
                sources.append((combo_text(km, c, base), [("combo", layer, i)], c.binding))
        shifts = [(f"Shift: {text}", presses) for text, presses, b in sources if is_shift(b)]
        for text, presses, b in sources:
            for kind, kc in outputs(b):
                if match(kc, False):
                    found.append(Way(pre_steps + [f"{kind}: {text}"], pre_presses + presses))
                elif not kc.shift and match(kc, True):
                    for s_text, s_presses in shifts:
                        found.append(Way(pre_steps + [s_text, f"{kind}: {text}"],
                                         pre_presses + s_presses + presses))
    found.sort(key=lambda w: w.cost)
    return found


def shortest(ways):
    return [w for w in ways if w.cost == ways[0].cost] if ways else []


def physical(km, presses):
    """Physical key positions behind a list of presses."""
    out = set()
    for kind, _, idx in presses:
        out.update([idx] if kind == "key" else km.combos[idx].positions)
    return out


# ---------------------------------------------------------------- chords

# Emacs modifier -> Mac modifier key, as set in the running Emacs:
# ns-control-modifier = control, ns-alternate-modifier = meta,
# ns-command-modifier = super; the right-hand ones are `left`, i.e. the same.
EMACS_MODS = {"C": "ctrl", "M": "alt", "s": "gui", "S": "shift"}

# Emacs key names (key-description) -> ZMK key
EMACS_KEYS = {
    "RET": "ENTER", "<return>": "ENTER", "TAB": "TAB", "<tab>": "TAB", "SPC": "SPACE",
    "DEL": "BSPC", "<backspace>": "BSPC", "ESC": "ESCAPE", "<escape>": "ESCAPE",
    "<left>": "LEFT", "<right>": "RIGHT", "<up>": "UP", "<down>": "DOWN",
    "<deletechar>": "DELETE", "<delete>": "DELETE", "<next>": "PAGE_DOWN", "<insert>": "INSERT",
    "<print>": "PRINTSCREEN", **{f"<f{i}>": f"F{i}" for i in range(1, 13)},
}

# Chords typed with Russian – PC reach Emacs translated to Latin by reverse-im,
# which is built from this input method (~/.emacs.d/init.el:203)…
IM_METHOD = Path("~/.emacs.d/lisp/cyrillic-dvorak-programming.el").expanduser()
# …plus the two translations added by hand at ~/.emacs.d/init.el:208-209.
CHORD_EXTRA_RU = {"/": ".", "?": ","}   # C-. -> C-/, C-, -> C-?

EMACS_EVENT = re.compile(r"((?:[ACHMSs]-)*)(.+)")
EMACS_EVENT_ALIASES = {"<backtab>": "S-TAB"}
# Chord rows that do not come from the keyboard.
NOT_KEYBOARD = re.compile(r"mouse|wheel|menu-bar|tool-bar|tab-bar|<ns-")


@functools.cache
def reverse_im():
    """Latin char of a logged chord -> the Cyrillic char really typed.

    From the quail rules of IM_METHOD. Rules whose target is ASCII are left
    out: reverse-im does not translate those (~/.emacs.d/init.el:204)."""
    if not IM_METHOD.exists():
        return {}
    out = {}
    for m in re.finditer(r'\("((?:\\.|[^"\\])+)"\s+\?(\\.|.)\)', IM_METHOD.read_text()):
        key = re.sub(r"\\(.)", r"\1", m.group(1))
        target = m.group(2)[-1]
        if len(key) == 1 and not target.isascii():
            out[key] = target
    return out


def chord_chars(layout, ch):
    """Chars the OS may have sent for a chord logged with `ch` as its key."""
    if layout != "RussianWin":
        return [ch]
    return [c for c in (reverse_im().get(ch), CHORD_EXTRA_RU.get(ch), ch) if c]


def modifier_sources(km, base):
    """modifier -> press lists that hold it on the base layer."""
    out = collections.defaultdict(list)
    for p, b in enumerate(km.layers[base]):
        if mod := held_modifier(b):
            out[mod].append([("key", base, p)])
    for i, c in enumerate(km.combos):
        if c.active_on(base) and (mod := held_modifier(c.binding)):
            out[mod].append([("combo", base, i)])
    return out


def chord_key_ways(km, layout, name):
    """Cheapest ways to press the non-modifier part of one chord event."""
    if name in EMACS_KEYS:
        return shortest(ways_for_key(km, layout, EMACS_KEYS[name]))
    if len(name) != 1:
        return []
    ways = sorted((w for c in chord_chars(layout, name) for w in ways_for(km, layout, c)),
                  key=lambda w: w.cost)
    return shortest(ways)


def chord_presses(km, layout, desc):
    """Presses of one chord ('C-x C-f') as {press: share}, or None if unreachable.

    A modifier held through consecutive events counts once. A modifier on
    several keys (Ctrl on both thumbs) is split between them, skipping keys
    the chord itself needs: C-SPC cannot take Ctrl from the Space key."""
    sources = modifier_sources(km, OS_LAYOUTS[layout])
    out = collections.Counter()
    held = set()
    for event in desc.split(" "):
        m = EMACS_EVENT.fullmatch(EMACS_EVENT_ALIASES.get(event, event))
        ways = chord_key_ways(km, layout, m.group(2)) if m else []
        if not ways:
            return None
        mods = set(m.group(1).replace("-", ""))
        for w in ways:
            share = 1 / len(ways)
            for p in w.presses:
                out[p] += share
            used = physical(km, w.presses)
            for mod in mods - held:
                srcs = [s for s in sources.get(EMACS_MODS.get(mod), []) if not physical(km, s) & used]
                if not srcs:
                    return None
                for s in srcs:
                    for p in s:
                        out[p] += share / len(srcs)
        held = mods
    return out


# ---------------------------------------------------------------- find

def cmd_find(args):
    km = load_keymap()
    layouts = [OS_LAYOUT_ALIASES[args.layout]] if args.layout else list(OS_LAYOUTS)
    chars = [ch for arg in args.chars for ch in ([" "] if arg == "SPC" else arg)]
    for char in chars:
        for layout in layouts:
            base = km.layer_names[OS_LAYOUTS[layout]]
            ways = ways_for(km, layout, char)
            head = f"{CHAR_NAMES.get(char, char)}  в {layout} (слой {base})"
            if not ways:
                print(f"{head}: не набирается\n")
                continue
            print(f"{head}:")
            for w in ways[: args.max]:
                print("  " + "  →  ".join(w.steps))
            if len(ways) > args.max:
                print(f"  … ещё {len(ways) - args.max}, --max N чтобы увидеть")
            print()


# ---------------------------------------------------------------- heatmap

@dataclass
class LogRow:
    event: str        # 'char' (backspace is '\b'), 'chord', or 'skip'
    value: str        # the char, the chord's key description, or why it is skipped
    layout: str
    interval: int     # ms since the previous logged command, -1 for the first one
    relabeled: bool   # layout differs from the logged `layout` column


def iter_log(days=None):
    """Rows of KLOG in order, with the macOS layout each one was typed in.

    A letter decides the layout itself (Cyrillic is Russian – PC). Other rows
    take the logged `layout` column where it is reliable
    (LAYOUT_RELIABLE_SINCE_MS), else the layout of the last letter before them."""
    since = (time.time() - days * 86400) * 1000 if days else 0
    current = None
    with KLOG.open(newline="") as f:
        for row in csv.DictReader(f):
            try:
                ts, interval = int(row["timestamp_ms"]), int(row["interval_ms"])
            except ValueError:
                continue
            logged, key = row["layout"], row["key"]
            if row["event"] == "backspace":
                event, value = "char", "\b"
            elif row["event"] == "char":
                event, value = "char", {"COMMA": ",", "SPC": " ", "TAB": "\t", "RET": "\n"}.get(key, key)
            else:
                event, value = "chord", "," if key == "COMMA" else key
            if event == "char" and len(value) == 1 and value.isalpha():
                current = layout = "RussianWin" if "Ѐ" <= value <= "ӿ" else "ABC"
            elif ts >= LAYOUT_RELIABLE_SINCE_MS and logged in OS_LAYOUTS:
                layout = logged
            else:
                layout = current or logged
            if ts < since:
                continue
            if event == "chord" and NOT_KEYBOARD.search(value):
                event, value = "skip", "мышь / меню"
            elif layout not in OS_LAYOUTS:
                event, value = "skip", f"layout {layout or '?'}"
            yield LogRow(event, value, layout, interval, layout != logged)


def read_log(days, chords=True):
    counts = collections.Counter()    # (event, layout, value) -> n
    skipped = collections.Counter()
    relabeled = 0
    for row in iter_log(days):
        if row.event == "skip":
            skipped[row.value] += 1
        elif row.event == "chord" and not chords:
            skipped["chord (--no-chords)"] += 1
        else:
            counts[(row.event, row.layout, row.value)] += 1
            relabeled += row.relabeled
    return counts, skipped, relabeled


def occurrence(km, event, layout, value):
    """Presses of one logged row as {press: share}, or None if the layout can't produce it."""
    if event == "chord":
        return chord_presses(km, layout, value)
    ways = shortest(ways_for(km, layout, value))
    if not ways:
        return None
    out = collections.Counter()
    for w in ways:
        for p in w.presses:
            out[p] += 1 / len(ways)
    return out


def heat(counts, km):
    keys = collections.Counter()      # (layer, pos) -> weight
    combos = collections.Counter()    # (layer, combo index) -> weight
    unreachable = collections.Counter()
    for (event, layout, value), n in counts.items():
        presses = occurrence(km, event, layout, value)
        if presses is None:
            unreachable[(event, layout, value)] += n
            continue
        for (kind, layer, idx), share in presses.items():
            (keys if kind == "key" else combos)[(layer, idx)] += n * share
    return keys, combos, unreachable


HEAT_COLORS = ["#fff7d6", "#ffeaa8", "#ffd47a", "#ffb35a", "#ff8c42", "#f2622e", "#d43a2a", "#a8201a"]


def bucket(v, vmax):
    """Colour index; sqrt scale relative to the busiest key of the same layer."""
    if v <= 0 or vmax <= 0:
        return None
    return min(len(HEAT_COLORS) - 1, int(len(HEAT_COLORS) * math.sqrt(v / vmax)))


def drawer(*args, stdin=None):
    r = subprocess.run(["uvx", "--quiet", "--from", "keymap-drawer", "keymap", *args],
                       input=stdin, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"keymap-drawer {args[2]} упал:\n{r.stderr}")
    return r.stdout


def drawer_config(extra_css=""):
    import yaml
    cfg = yaml.safe_load(DRAWER_CONFIG.read_text())
    cfg["draw_config"]["svg_extra_style"] = cfg["draw_config"].get("svg_extra_style", "") + extra_css
    f = tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False)
    yaml.safe_dump(cfg, f, allow_unicode=True)
    f.close()
    return f.name


def parsed_keymap(cfg):
    import yaml
    return yaml.safe_load(drawer("-c", cfg, "parse", "-z", str(KEYMAP)))


def render(cfg, data, name):
    import yaml
    OUT.mkdir(exist_ok=True)
    svg = drawer("-c", cfg, "draw", "-j", str(LAYOUT_JSON), "-",
                 stdin=yaml.safe_dump(data, allow_unicode=True, sort_keys=False))
    path = OUT / name
    path.write_text(svg)
    return path


def open_in_emacs(path):
    subprocess.run(["emacsclient", "-n", str(path)], check=False)


def cmd_heatmap(args):
    km = load_keymap()
    counts, skipped, relabeled = read_log(args.days, chords=not args.no_chords)
    keys, combos, unreachable = heat(counts, km)
    vmax = collections.defaultdict(lambda: 1.0)
    for (layer, _), v in [*keys.items(), *combos.items()]:
        vmax[layer] = max(vmax[layer], v)

    css = "".join(f"\nrect.heat{i}, rect.combo.heat{i} {{ fill: {c}; }}" for i, c in enumerate(HEAT_COLORS))
    cfg = drawer_config(css)
    data = parsed_keymap(cfg)
    old_names = list(data["layers"])
    totals = collections.Counter()
    for (layer, _), v in keys.items():
        totals[layer] += v
    usage = {v: k for k, v in OS_LAYOUTS.items()}

    def tag(spec, b):
        spec = {"t": spec} if not isinstance(spec, dict) else dict(spec)
        if b is not None and spec.get("type") not in ("none", "trans"):
            spec["type"] = f"heat{b}"
        return spec

    new_layers, rename = {}, {}
    for li, name in enumerate(old_names):
        title = f"{name} · {usage.get(li, 'из базового')} · {round(totals[li])} нажатий"
        rename[name] = title
        new_layers[title] = [tag(k, bucket(keys[(li, p)], vmax[li])) for p, k in enumerate(data["layers"][name])]
    data["layers"] = new_layers

    # Split each drawn combo per layer so every layer shows its own heat.
    new_combos = []
    for c in data.get("combos", []):
        layer_names = c.get("l") or old_names
        for ln in layer_names:
            li = old_names.index(ln)
            idx = next((i for i, kc in enumerate(km.combos)
                        if sorted(kc.positions) == sorted(c["p"]) and kc.active_on(li)), None)
            b = bucket(combos[(li, idx)], vmax[li]) if idx is not None else None
            new_combos.append({**c, "k": tag(c.get("k", ""), b), "l": [rename[ln]]})
    data["combos"] = new_combos

    path = render(cfg, data, "heatmap.svg")
    total = collections.Counter()
    for (event, _, _), n in counts.items():
        total[event] += n
    print(f"{path}\n")
    print(f"Учтено {total['char']} символов и {total['chord']} сочетаний из {KLOG} (только Emacs, без eshell/term).")
    if skipped:
        print("Не учтено: " + ", ".join(f"{k} {v}" for k, v in skipped.most_common()))
    if relabeled:
        print(f"У {relabeled} строк раскладка взята по буквам, а не из колонки layout: "
              f"до 2026-10-02 20:49 колонка отставала от переключений.")

    top = sorted(((v, ("key", l, p)) for (l, p), v in keys.items()), reverse=True)[:12]
    print("\nСамые нагруженные клавиши")
    print(f"{'Клавиша':<64} {'Слой':<7} {'Нажатий':>8}")
    print("─" * 81)
    for v, (_, l, p) in top:
        print(f"{describe_pos(p) + ' [' + pos_label(km, p) + ']':<64} {km.layer_names[l]:<7} {round(v):>8}")
    ctop = sorted(((v, k) for k, v in combos.items()), reverse=True)[:10]
    if ctop:
        print("\nCombos")
        print(f"{'Combo':<22} {'Слой':<7} {'Нажатий':>8}")
        print("─" * 39)
        for v, (l, i) in ctop:
            print(f"{km.combos[i].name:<22} {km.layer_names[l]:<7} {round(v):>8}")
    for event, title in (("char", "Символы, которых раскладка не даёт (другая клавиатура или ввод не с клавиш)"),
                         ("chord", "Сочетания, для которых на раскладке нет клавиши")):
        items = [(n, l, v) for (e, l, v), n in unreachable.most_common() if e == event][:15]
        if items:
            print(f"\n{title}:")
            print("  " + ", ".join(f"{CHAR_NAMES.get(v, v)} ({l}) {n}" for n, l, v in items))
    if args.open:
        open_in_emacs(path)


# ---------------------------------------------------------------- bigrams

BIGRAM_GROUPS = ["та же клавиша", "тот же палец", "та же рука", "разные руки", "через SPEC / Shift / combo"]


def finger_label(km, way):
    """Who presses the char: 'левый указательный', 'combo_minus', with +SPEC / +Shift."""
    kind, layer, idx = way.presses[-1]
    if kind == "combo":
        label = km.combos[idx].name
    else:
        hand, finger, where = pos_info(idx)
        label = f"{hand} {finger}" if hand else where
    via_spec = layer == SPEC
    if via_spec:
        label += " +SPEC"
    if way.cost > 1 + via_spec:
        label += " +Shift"
    return label


def bigram_group(a, b):
    """How two consecutive chars sit under the fingers (a, b are their Ways)."""
    if a.cost > 1 or b.cost > 1 or a.presses[-1][0] == "combo" or b.presses[-1][0] == "combo":
        return "через SPEC / Shift / combo"
    pa, pb = a.presses[-1][2], b.presses[-1][2]
    if pa == pb:
        return "та же клавиша"
    (ha, fa, _), (hb, fb, _) = pos_info(pa), pos_info(pb)
    if ha is None or ha != hb:
        return "разные руки"
    if fa.split(" (")[0] == fb.split(" (")[0]:   # the inner index column is the index finger
        return "тот же палец"
    return "та же рука"


def cmd_bigrams(args):
    km = load_keymap()
    first_way = {}

    def way(layout, ch):
        if (layout, ch) not in first_way:
            ways = shortest(ways_for(km, layout, ch))
            first_way[(layout, ch)] = ways[0] if ways else None
        return first_way[(layout, ch)]

    pairs = collections.defaultdict(list)   # (layout, a, b) -> intervals, ms
    prev = None
    for row in iter_log(args.days):
        if (row.event == "char" and prev is not None and prev.event == "char"
                and "\b" not in (prev.value, row.value) and prev.layout == row.layout
                and 0 < row.interval <= args.max_ms):
            pairs[(row.layout, prev.value, row.value)].append(row.interval)
        prev = row

    groups = collections.defaultdict(list)
    slow = []
    for (layout, a, b), intervals in pairs.items():
        wa, wb = way(layout, a), way(layout, b)
        if wa is None or wb is None:
            continue
        group = bigram_group(wa, wb)
        groups[group].extend(intervals)
        if len(intervals) >= args.min:
            slow.append((statistics.median(intervals), len(intervals), layout, a, b, group, wa, wb))

    print(f"Пары символов подряд с интервалом до {args.max_ms} мс: {sum(map(len, groups.values()))} "
          f"из {KLOG}.")
    print("Символ с несколькими способами набора взят по первому из самых коротких.\n")
    print(f"{'Как стоят клавиши':<28} {'Пар':>8} {'Медиана, мс':>12}")
    print("─" * 50)
    for group in BIGRAM_GROUPS:
        if groups.get(group):
            print(f"{group:<28} {len(groups[group]):>8} {statistics.median(groups[group]):>12.0f}")

    print(f"\nСамые медленные пары (встретились не меньше {args.min} раз)")
    print(f"{'Пара':<9} {'Раскладка':<11} {'Медиана':>7} {'Раз':>6}  {'Как стоят клавиши':<27} Пальцы")
    print("─" * 104)
    for med, n, layout, a, b, group, wa, wb in sorted(slow, key=lambda r: (r[0], r[1]), reverse=True)[: args.top]:
        pair = f"{CHAR_NAMES.get(a, a)} {CHAR_NAMES.get(b, b)}"
        print(f"{pair:<9} {layout:<11} {med:>7.0f} {n:>6}  {group:<27} "
              f"{finger_label(km, wa)} → {finger_label(km, wb)}")


